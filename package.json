{
  "name": "depawn",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @depawn/api db:migrate",
    "db:seed": "pnpm --filter @depawn/api db:seed",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run typecheck lint && prettier --check . && bash scripts/check-boundaries.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  }
}
